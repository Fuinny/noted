@model IEnumerable<Noted.Models.Note>

@{
    ViewData["Title"] = "My Notes";
}

<div class="container mt-4" style="max-width: 700px">
    <h2 class="mb-4 text-center">My Notes</h2>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-controller="Notes" asp-action="Store" method="post">
                <div class="mb-2">
                    <input name="Title" class="form-control" placeholder="Title" required />
                </div>
                <div class="mb-4">
                    <textarea name="Content" class="form-control" rows="10" placeholder="Take a note..."
                              style="resize: none; overflow-y: scroll;" required></textarea>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var note in Model)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@note.Title</h5>
                        <p class="card-text text-muted" style="white-space: pre-line;">@note.Content</p>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted float-start">@note.CreatedAt.ToLocalTime().ToString("g")</small>
                        <form asp-controller="Notes" asp-action="Delete" asp-route-id="@note.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-danger float-end"
                                    onclick="return confirm('Delete this note?')">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
